@model TeacherViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--Toast-->
<span id="AlertMessage" class="d-none">@TempData["AlertMessage"]</span>

<div aria-live="polite" aria-atomic="true" style="position: relative;">
    <div class="toast custom-container" data-delay="4000">
        <div class="toast-header text-white">
            <strong class="mr-auto"> @TempData["AlertMessage"]</strong>
            <button type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    </div>
</div>

<div class="container mt-5 pt-5">
    <h2 class="mb-3">Register Teacher</h2>
    <form action="Save" method="post" class="form-group">
        <!--ID and password generated automatically-->
        <input type="hidden" name="operation" value="@ViewBag.Operation" />
        <input type="hidden" name="ID" value="@Model.ID" />
        <label for="Name" class="mt-1">Name</label>
        <input asp-for="Name" class="form-control custom-field" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <br />
        <label for="Email" class="mt-1">Email</label>
        <input asp-for="Email" class="form-control custom-field" />
        <span asp-validation-for="Email" class="text-danger"></span>
        <br />
        <label for="Phone" class="mt-1">Phone</label>
        <input asp-for="Phone" class="form-control custom-field" />
        <span asp-validation-for="Phone" class="text-danger"></span>
        <br />
        @if (ViewBag.Operation == "A")
        {
            <label for="CPF" class="mt-1">CPF</label>
            <input asp-for="CPF" class="form-control custom-field" readonly />
            <span asp-validation-for="CPF" class="text-danger"></span>
        }
        else
        {
            <label for="CPF" class="mt-1">CPF</label>
            <input asp-for="CPF" class="form-control custom-field" />
            <span asp-validation-for="CPF" class="text-danger"></span>
        }
        <br />

        <!--Toast: To notify success-->
        <input type="submit" value="Register" class="btn btn-success custom-button mt-1" />
    </form>
</div>