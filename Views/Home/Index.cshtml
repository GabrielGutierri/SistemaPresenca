    ViewData["Title"] = "Home Page";
}

<div class="container-fluid pt-md-5 main-image">
    <div class="container mt-5 pt-5">
        <div class="text-center text-white">
            <h1>Finger Hero</h1>
            <hr class="menu-divider" />
        </div>
    </div>
</div>
<div class="container">
    <div class="m-5">
        <h3 class="m-5 text-center">Biometrics</h3>
        <img class="image-size float-left mb-2" src="/Images/fingerprints.jpg" />
        <p class="text-size">
            The main advantages of biometrics are: <br />
            -   It makes life more practical, as there is no need to remember a password,
            nor is it necessary to carry any type of object, such as: tags, cards,
            wristbands, etc.<br />
            -   Biometrics represents security, since we can link this information to a specific individual, making fraud
            more difficult and guaranteeing the authenticity of the user's identity. <br />
            -   It has high precision and ensures greater comfort, practicality and speed throughout the process, which reduces queues and makes life
            easier for everyone.
        </p>
    </div>
</div>